{
  "name": "@twofau/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:firefox": "node scripts/dev-firefox.mjs",
    "build": "tsc --noEmit && vite build",
    "pack:firefox": "node scripts/pack-firefox.mjs",
    "build:browsers": "pnpm build && pnpm pack:firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --no-config-discovery",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@twofau/core-wasm": "workspace:*",
    "@twofau/ui": "workspace:*",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^2.1.9",
    "web-ext": "^8.3.0"
  }
}
