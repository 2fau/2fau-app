---
import HomePage from '../components/HomePage.astro';
import { HeroCta } from '../components/home/HeroCta';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="2FAu — Local-first 2FA authenticator for desktop & browser"
	description="Generate your TOTP/HOTP two-factor codes in an encrypted local vault — no account, no server. A native menu-bar app for macOS, Windows and Linux, plus a Chrome & Firefox extension, from one Rust core."
>
	<HomePage>
		<HeroCta slot="heroCta" client:load />
	</HomePage>
</Layout>
