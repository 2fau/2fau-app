---
import { getT } from "../../i18n/t";
const t = getT(Astro.currentLocale).t;
---
    <div
            data-pencil-name="Page Header"
            class="box-border w-full h-fit shrink-0 flex flex-row gap-0 p-[92px_40px_76px_40px] justify-center items-start bg-[#0B0B0D] max-md:px-5 max-md:py-16"
          >
            <div
              data-pencil-name="Header Inner"
              class="box-border w-full max-w-[1200px] shrink-0 h-fit flex flex-col gap-0 justify-start items-start"
            >
              <div
                data-pencil-name="Eyebrow"
                class="text-[11.5px]/[normal] box-border text-[#0A84FF] font-['JetBrains_Mono',system-ui,sans-serif] font-normal tracking-[1.4px] text-left [white-space:nowrap]"
              >
                {t("SECURITY")}
              </div>
              <div
                data-pencil-name="Title Wrap"
                class="box-border w-full max-w-[760px] h-fit shrink-0 flex flex-row gap-0 p-[20px_0px_0px_0px] justify-start items-start"
              >
                <h1
                  data-pencil-name="Title"
                  class="text-[52px]/[56px] box-border [flex:1_1_0] text-[#F5F5F7] font-[Inter,system-ui,sans-serif] font-bold tracking-[-1.8px] text-left max-md:text-[32px]/[1.12]"
                >
                  {t("What protects your secrets, and what doesn't.")}
                </h1>
              </div>
              <div
                data-pencil-name="Subhead Wrap"
                class="box-border w-full max-w-[680px] h-fit shrink-0 flex flex-row gap-0 p-[24px_0px_0px_0px] justify-start items-start"
              >
                <div
                  data-pencil-name="Subhead"
                  class="text-[17px]/[28px] box-border [flex:1_1_0] text-[#98989D] font-[Inter,system-ui,sans-serif] font-normal text-left"
                >
                  {t("2FAu is a local-first authenticator: there is no account and no 2FAu server, and the only sync is one you switch on. This page describes the vault format, the key handling, and the attacks it deliberately does not defend against.")}
                </div>
              </div>
              <div
                data-pencil-name="Meta Wrap"
                class="box-border w-full h-fit shrink-0 flex flex-row gap-[10px] p-[34px_0px_0px_0px] justify-start items-center max-md:flex-wrap"
              >
                <div
                  data-pencil-name="Meta VAULT VERSION"
                  class="box-border w-fit shrink-0 h-fit flex flex-row gap-[8px] p-[7px_12px] justify-start items-center bg-[#1B1B1E] [outline:1px_solid_#262628] [outline-offset:-0.5px] rounded-[6px] max-md:flex-wrap max-w-full"
                >
                  <div
                    data-pencil-name="Meta Key"
                    class="text-[11px]/[normal] box-border text-[#8E8E93] font-['JetBrains_Mono',system-ui,sans-serif] font-normal tracking-[0.6px] text-left [white-space:nowrap]"
                  >
                    {t("VAULT VERSION")}
                  </div>
                  <div
                    data-pencil-name="Meta Value"
                    class="text-[11.5px]/[normal] box-border text-[#F5F5F7] font-['JetBrains_Mono',system-ui,sans-serif] font-normal text-left [white-space:nowrap]"
                  >
                    1
                  </div>
                </div>
                <div
                  data-pencil-name="Meta KDF ID"
                  class="box-border w-fit shrink-0 h-fit flex flex-row gap-[8px] p-[7px_12px] justify-start items-center bg-[#1B1B1E] [outline:1px_solid_#262628] [outline-offset:-0.5px] rounded-[6px] max-md:flex-wrap max-w-full"
                >
                  <div
                    data-pencil-name="Meta Key"
                    class="text-[11px]/[normal] box-border text-[#8E8E93] font-['JetBrains_Mono',system-ui,sans-serif] font-normal tracking-[0.6px] text-left [white-space:nowrap]"
                  >
                    {t("KDF ID")}
                  </div>
                  <div
                    data-pencil-name="Meta Value"
                    class="text-[11.5px]/[normal] box-border text-[#F5F5F7] font-['JetBrains_Mono',system-ui,sans-serif] font-normal text-left [white-space:nowrap]"
                  >
                    1
                  </div>
                </div>
                <div
                  data-pencil-name="Meta LICENCE"
                  class="box-border w-fit shrink-0 h-fit flex flex-row gap-[8px] p-[7px_12px] justify-start items-center bg-[#1B1B1E] [outline:1px_solid_#262628] [outline-offset:-0.5px] rounded-[6px] max-md:flex-wrap max-w-full"
                >
                  <div
                    data-pencil-name="Meta Key"
                    class="text-[11px]/[normal] box-border text-[#8E8E93] font-['JetBrains_Mono',system-ui,sans-serif] font-normal tracking-[0.6px] text-left [white-space:nowrap]"
                  >
                    {t("LICENCE")}
                  </div>
                  <div
                    data-pencil-name="Meta Value"
                    class="text-[11.5px]/[normal] box-border text-[#F5F5F7] font-['JetBrains_Mono',system-ui,sans-serif] font-normal text-left [white-space:nowrap]"
                  >
                    MIT
                  </div>
                </div>
              </div>
            </div>
          </div>
