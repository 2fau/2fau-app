---
import Nav from "./home/Nav.astro";
import Hero from "./home/Hero.astro";
import ProductShot from "./home/ProductShot.astro";
import SurfacesBand from "./home/SurfacesBand.astro";
import Security from "./home/Security.astro";
import Extension from "./home/Extension.astro";
import Features from "./home/Features.astro";
import FinalCta from "./home/FinalCta.astro";
import Footer from "./home/Footer.astro";
---

<div
  data-pencil-name="2FAu Landing"
  class="box-border h-fit flex flex-col gap-0 justify-start items-start bg-[#0B0B0D] overflow-hidden"
>
  <Nav />
  <div
    data-pencil-name="Nav Divider"
    class="box-border w-full h-[1px] shrink-0 bg-[#262628]"
  ></div>
  <Hero />
  <ProductShot />
  <div
    data-pencil-name="Band Divider Top"
    class="box-border w-full h-[1px] shrink-0 bg-[#262628]"
  ></div>
  <SurfacesBand />
  <div
    data-pencil-name="Band Divider Bottom"
    class="box-border w-full h-[1px] shrink-0 bg-[#262628]"
  ></div>
  <Security />
  <Extension />
  <Features />
  <FinalCta />
  <div
    data-pencil-name="Footer Divider Top"
    class="box-border w-full h-[1px] shrink-0 bg-[#262628]"
  ></div>
  <Footer />
</div>
