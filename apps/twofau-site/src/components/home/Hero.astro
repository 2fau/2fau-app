          class="block text-[70px]/[74px] box-border w-full text-[#F5F5F7] font-[Inter,system-ui,sans-serif] font-semibold tracking-[-2.4px] text-center max-md:text-[43px]/[1.12]"
        >
          {t("Two-factor codes")}
