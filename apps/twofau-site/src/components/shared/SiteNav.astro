---
import { NavInstallButton } from "./NavInstallButton";
import LanguageSelector from "./LanguageSelector.astro";
import { getT, localeUrl } from "../../i18n/t";

interface Props {
  active?: "desktop" | "extension" | "security";
}
const { active } = Astro.props;
const locale = Astro.currentLocale ?? "en";
const t = getT(locale).t;
const url = (path: string) => localeUrl(locale, path);
---
    <div
            data-pencil-name="Nav"
            class="box-border w-full h-fit shrink-0 flex flex-row gap-0 p-[18px_40px] justify-between items-center"
          >
            <div
              data-pencil-name="Nav Left"
              class="box-border w-fit shrink-0 h-fit flex flex-row gap-[36px] justify-start items-center"
            >
              <a href={url("")}
                data-pencil-name="Logo"
                class="box-border w-fit shrink-0 h-fit flex flex-row gap-[9px] justify-start items-center"
              >
                <div
                  data-pencil-name="Logo Mark"
                  class="box-border w-[26px] shrink-0 h-[26px] relative"
                >
                  <div
                    data-pencil-name="Ring Track"
                    class="box-border w-[22.334px] h-[22.334px] absolute left-[1.828px] top-[1.828px] bg-[#0A84FF3D] [clip-path:path('M11.167_0_C17.334_0_22.334_5_22.334_11.167_C22.334_17.334_17.334_22.334_11.167_22.334_C5_22.334_0_17.334_0_11.167_C0_5_5_0_11.167_0_Z_M11.167_2.032_C6.122_2.032_2.032_6.122_2.032_11.167_C2.032_16.212_6.122_20.302_11.167_20.302_C16.212_20.302_20.302_16.212_20.302_11.167_C20.302_6.122_16.212_2.032_11.167_2.032_Z')] [z-index:0]"
                  ></div>
                  <div
                    data-pencil-name="Ring Progress"
                    class="box-border w-[22.334px] h-[22.334px] absolute left-[1.828px] top-[1.828px] bg-[#0A84FF] [clip-path:path('M11.167_0_C17.334_0_22.334_5_22.334_11.167_C22.334_17.334_17.334_22.334_11.167_22.334_C5_22.334_0_17.334_0_11.167_L2.032_11.167_C2.032_16.212_6.122_20.302_11.167_20.302_C16.212_20.302_20.302_16.212_20.302_11.167_C20.302_6.122_16.212_2.032_11.167_2.032_L11.167_0_Z')] [z-index:1]"
                  ></div>
                  <svg
                    data-pencil-name="U Glyph"
                    viewBox="0 0 64 64"
                    preserveAspectRatio="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="box-border w-[26px] h-[26px] absolute left-0 top-0 overflow-visible [z-index:2]"
                  >
                    <path
                      d="M22 22.5v9a10 10 0 0 0 20 0v-9m0 0v19"
                      fill="none"
                      stroke="#FFFFFF"
                      stroke-width="2.641"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      vector-effect="non-scaling-stroke"
                    ></path>
                  </svg>
                </div>
                <div
                  data-pencil-name="Wordmark"
                  class="text-[16px]/[normal] box-border text-[#F5F5F7] font-[Inter,system-ui,sans-serif] font-semibold tracking-[-0.2px] text-left [white-space:nowrap]"
                >
                  2FAu
                </div>
              </a>
              <div
                data-pencil-name="Nav Links"
                class="box-border w-fit shrink-0 h-fit flex flex-row gap-[26px] justify-start items-center"
              >
                <a href={url("desktop")}
                  data-pencil-name="Desktop"
                  class={`text-[13.5px]/[normal] box-border ${active === "desktop" ? "text-[#F5F5F7]" : "text-[#98989D]"} font-[Inter,system-ui,sans-serif] font-normal text-left [white-space:nowrap] transition-colors hover:text-[#F5F5F7]`}>
                {t("Desktop")}
                </a>
                <a href={url("extension")}
                  data-pencil-name="Extension"
                  class={`text-[13.5px]/[normal] box-border ${active === "extension" ? "text-[#F5F5F7]" : "text-[#98989D]"} font-[Inter,system-ui,sans-serif] font-normal text-left [white-space:nowrap] transition-colors hover:text-[#F5F5F7]`}>
                {t("Extension")}
                </a>
                <a href={url("security")}
                  data-pencil-name="Security"
                  class={`text-[13.5px]/[normal] box-border ${active === "security" ? "text-[#F5F5F7]" : "text-[#98989D]"} font-[Inter,system-ui,sans-serif] font-normal text-left [white-space:nowrap] transition-colors hover:text-[#F5F5F7]`}>
                {t("Security")}
                </a>
              </div>
            </div>
            <div
              data-pencil-name="Nav Right"
              class="box-border w-fit shrink-0 h-fit flex flex-row gap-[10px] justify-start items-center"
            >
              <a href={url("desktop")}
                data-pencil-name="Download"
                class="text-[13.5px]/[normal] box-border text-[#98989D] font-[Inter,system-ui,sans-serif] font-normal text-left [white-space:nowrap] transition-colors hover:text-[#F5F5F7]"
              >
                {t("Download")}
              </a>
              <LanguageSelector />
              <NavInstallButton
                client:load
                labels={{
                  chrome: t("Add to Chrome"),
                  firefox: t("Add to Firefox"),
                  edge: t("Add to Edge"),
                }}
              />
            </div>
          </div>
